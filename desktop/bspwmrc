#!/bin/sh
# Minimal tiling session for the agent desktop.

bspc monitor -d main

bspc config border_width 1
bspc config window_gap 16
if [ "${MIM_DESKTOP_BAR:-0}" = "1" ]; then
  bspc config top_padding 28
else
  bspc config top_padding 0
fi
bspc config split_ratio 0.5
bspc config automatic_scheme spiral
bspc config borderless_monocle true
bspc config focus_follows_pointer false
bspc config pointer_follows_focus false

bspc config normal_border_color "#232326"
bspc config active_border_color "#232326"
bspc config focused_border_color "#FF4D00"
bspc config presel_feedback_color "#FF4D00"

bspc rule -a '*' focus=on
bspc rule -a Surf state=tiled
